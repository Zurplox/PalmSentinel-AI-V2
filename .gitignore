# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Drone imagery is private and must never be tracked.
*.tif
*.tiff
*.jpg
*.jpeg
*.png
!data/demo_palm_estate.jpg

# Outputs
output/
*.csv
*.geojson

# Build artefacts.  The spec files are source and are tracked; what they emit is
# not -- dist/ is ~200 MB of bundled interpreter and libraries, reproducible with
# `pyinstaller --noconfirm PalmSentinelV2.spec`.
build/
dist/
*.manifest

# The launcher writes this on every run so a silent failure is impossible.
launcher.log

# IDE
.vscode/
.idea/
.DS_Store

# Agent/editor scratch that belongs to the machine, not the project.
.freebuff/

# A `%SystemDrive%` directory of Windows API-set cache files appears in the
# working directory of the build or of the packaged app, under conditions not yet
# identified (see SYSTEM_LIVING_LOG_V2.md, 2026-09-23 15:22).  It is not written
# by this project -- `grep SystemDrive` finds nothing here -- and it is 900 KB of
# nothing, so it is ignored rather than swept up by a careless commit.
%SystemDrive%/
